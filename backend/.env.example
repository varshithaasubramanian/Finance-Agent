# Database
DATABASE_URL=sqlite:///./finance_agent.db

# AI configuration (optional). If AI_API_KEY is left empty, the app falls back
# to deterministic rule-based parsing/insights automatically.
AI_API_KEY=
AI_MODEL=claude-3-5-haiku-latest
AI_PROVIDER=anthropic

# Security — used to sign login sessions (JWTs). MUST be a long random
# value in production; anyone with this key can forge login tokens.
SECRET_KEY=change-this-to-a-random-secret-in-production

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true
